<% reports_data.each do |court_name, months| %>
  <h2><%= court_name.capitalize %></h2>

  <table border="1">
    <thead>
    <tr>
      <th>Month</th>
      <th>Judge</th>
      <th>Opening Balance</th>
      <th>Registered</th>
      <th>Decided</th>
      <th>Appeal</th>
      <th>Pending</th>
    </tr>
    </thead>
    <tbody>
    <% months.each do |month_name, judges| %>
      <% rowspan = judges.keys.size %>
      <% judges.each_with_index do |(judge_name, stats), index| %>
        <tr>
          <% if index == 0 %>
            <td rowspan="<%= rowspan %>"><%= month_name %></td>
          <% end %>
          <td><%= judge_name %></td>
          <td><%= stats[:opening_balance] %></td>
          <td><%= stats[:registered] %></td>
          <td><%= stats[:decided] %></td>
          <td><%= stats[:appeal] %></td>
          <td><%= stats[:pending] %></td>
        </tr>
      <% end %>
    <% end %>
    </tbody>
  </table>
<% end %>
