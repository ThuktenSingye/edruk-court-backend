<table>
  <thead>
  <tr>
    <th>Court</th>
    <th>Opening Balance</th>
    <th>Registered</th>
    <th>Total</th>
    <th>Decided</th>
    <th>Pending</th>
    <% if court_type != 'supreme' %>
      <th>Appeal</th>
      <th>Enforced</th>
    <% end %>
  </tr>
  </thead>
  <tbody>
  <% court_data.each do |court_name, data| %>
    <% # for array, pass court_name as nil %>
    <tr>
      <td><%= court_name.present? ? court_name.capitalize : court_type.capitalize %></td>
      <td><%= data[:opening_balance].to_s %></td>
      <td><%= data[:registered] %></td>
      <td><%= data[:total] %></td>
      <td><%= data[:decided] %></td>
      <td><%= data[:pending] %></td>
      <% if court_type != 'supreme' %>
       <td><%= data[:appeal] %></td>
        <td><%= data[:enforced] %></td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
