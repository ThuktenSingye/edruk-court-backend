<!DOCTYPE html>
<html>
<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  <style>
      body {
          font-family: Arial, sans-serif;
          background-color: #f9f9f9;
          padding: 20px;
          color: #333;
      }

      .email-container {
          background: #fff;
          border: 1px solid #ddd;
          border-radius: 8px;
          padding: 20px;
          max-width: 600px;
          margin: auto;
      }

      h2 {
          color: #2c3e50;
      }

      .case-info {
          margin-top: 20px;
          line-height: 1.6;
      }

      .footer {
          margin-top: 30px;
          font-size: 0.9em;
          color: #666;
      }
  </style>
</head>

<body>
<div class="email-container">
  <h2><%= t('new_case', default: "New Case Notification") %></h2>

  <p>Dear Sir/Madam,</p>

  <p>
    A new case has been filed against you by
    <strong><%= @filer&.profile&.first_name || "Unknown" %> <%= @filer&.profile&.last_name || "Unknown" %></strong>.
    Please find the case details below:
  </p>

  <div class="case-info">
    <p><strong>Case Title:</strong> <%= @court_case.title %></p>
    <p><strong>Summary:</strong> <%= @court_case.summary %></p>
  </div>

  <p>Please log in to the Edruk Court Mobile App to view more details or respond to the case.</p>

  <div class="footer">
    <p>Thank you,<br/>Edruk Court System</p>
  </div>
</div>
</body>
</html>
